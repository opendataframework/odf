# Copy to .env to change any of these. Every one has a default in compose.yaml,
# so the demo also runs without a .env.

# The simulation: its random seed, and simulated seconds per real second
# (60: a day in 24 minutes).
SEED=7
SPEED=60

# The tools' credentials, which the bakery's odf project integrates with.
POS_TOKEN=pos-dev-token
POS_WEBHOOK_SECRET=pos-dev-secret
MESSENGER_TOKEN=messenger-dev-token
MESSENGER_APP_SECRET=messenger-dev-secret
MAIL_PASSWORD=bakery

# A local model for the bakery's agents, through Ollama. Unset, the agents use
# rules only, and leave what the rules can't read for a person to review. To
# use the host's Ollama: OLLAMA_URL=http://host.docker.internal:11434
# The prompts are tuned on gpt-oss:20b (ollama pull gpt-oss:20b), which the
# chat window uses too (config.toml's [project.chat]).
OLLAMA_URL=
OLLAMA_MODEL=gpt-oss:20b

# A package index the bakery's image build looks in besides PyPI, for an
# opendataframework release that isn't published yet. Empty: PyPI only. For a
# local index on the host: ODF_INDEX_URL=http://host.docker.internal:8080/simple/
ODF_INDEX_URL=
