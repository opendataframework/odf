# Copy to .env (git-ignored) and fill in.

# The login, for compose.yaml.
ODF_USER=odf
ODF_PASSWORD=

# Your identity provider, for compose.oidc.yaml. Register a client with
# https://localhost/oauth2/callback as its redirect URL.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in, by email domain; * lets in anyone the provider knows.
OIDC_EMAIL_DOMAINS=*
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# A package index to install odf from besides PyPI (see the README).
ODF_INDEX_URL=
